# Database
# For local development, use a PostgreSQL connection string
# For Vercel deployment, this will be auto-populated when you add Vercel Postgres
DATABASE_URL="postgresql://user:password@localhost:5432/trailready_dev"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
