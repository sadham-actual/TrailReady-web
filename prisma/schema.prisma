// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums matching TypeScript domain types
enum Status {
  clear
  rough
  impassable
}

enum Confidence {
  low
  medium
  high
}

enum VehicleType {
  stockSUV_solidAxle
  stockSUV_IFS
  stockSUV_IFRS
  lifted4x4_solidAxle
  lifted4x4_IFS
  lifted4x4_IFRS
  sideBySide
  dirtBike
}

// User model - starts with anonymous users only
model User {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  isAnonymous Boolean  @default(true)

  // Future: add email, passwordHash, name for real authentication
  // email        String?   @unique
  // passwordHash String?
  // name         String?

  reports ConditionReport[]

  @@map("users")
}

// Trail model - matches existing Trail interface
model Trail {
  id             String   @id @default(cuid())
  name           String
  region         String
  latitude       Float
  longitude      Float
  description    String?
  baseDifficulty Int?     // 1-4 scale: 1=easy, 2=moderate, 3=difficult, 4=extreme. Used as fallback when no recent reports.
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  reports ConditionReport[]
  photos  Photo[]

  // Indexes for common queries
  @@index([region])
  @@index([name])
  @@map("trails")
}

// Photo model - trail intel imagery
model Photo {
  id        String   @id @default(cuid())
  url       String
  caption   String?
  trailId   String
  createdAt DateTime @default(now())

  // Relations
  trail Trail @relation(fields: [trailId], references: [id], onDelete: Cascade)

  // Indexes
  @@index([trailId, createdAt(sort: Desc)])
  @@map("photo")
}

// ConditionReport model - matches existing ConditionReport interface
model ConditionReport {
  id          String      @id @default(cuid())
  trailId     String
  userId      String
  status      Status
  confidence  Confidence
  vehicleType VehicleType
  notes       String?     @db.Text
  timestamp   DateTime    @default(now())
  createdAt   DateTime    @default(now())

  // Relations
  trail Trail @relation(fields: [trailId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Indexes for common queries (reports by trail, sorted newest first)
  @@index([trailId, timestamp(sort: Desc)])
  @@index([userId])
  @@map("condition_reports")
}

// Waitlist model - 
model Waitlist {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
  status    String   @default("PENDING")

  @@map("waitlist") // This forces Prisma to look for the lowercase table
}