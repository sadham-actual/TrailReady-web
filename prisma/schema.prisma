// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums matching TypeScript domain types
enum Status {
  clear
  rough
  impassable
}

enum Confidence {
  low
  medium
  high
}

enum VehicleType {
  stockSUV_solidAxle
  stockSUV_IFS
  stockSUV_IFRS
  lifted4x4_solidAxle
  lifted4x4_IFS
  lifted4x4_IFRS
  sideBySide
  dirtBike
}

// User model - starts with anonymous users only
model User {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  isAnonymous Boolean  @default(true)

  // Future: add email, passwordHash, name for real authentication
  // email        String?   @unique
  // passwordHash String?
  // name         String?

  reports     ConditionReport[]
  vehicles    UserVehicle[]
  tripBundles TripBundle[]

  @@map("users")
}

// Trail model - matches existing Trail interface
model Trail {
  id             String   @id @default(cuid())
  name           String
  region         String
  latitude       Float
  longitude      Float
  description    String?
  baseDifficulty Int?     // 1-4 scale: 1=easy, 2=moderate, 3=difficult, 4=extreme. Used as fallback when no recent reports.

  // Planning-first additive fields (MVP v0.1)
  difficultyScore Int?    // 1-10 planning difficulty score
  terrainType     String? // Rock | Sand | Mud (kept string for additive/non-breaking migration)
  minTireSize     Float?
  requiredGear    Json?
  currentStatus   String? // Open | Closed

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  reports ConditionReport[]
  photos  Photo[]
  tripBundleTrails TripBundleTrail[]

  // Indexes for common queries
  @@index([region])
  @@index([name])
  @@map("trails")
}

// Photo model - trail intel imagery
model Photo {
  id        String   @id @default(cuid())
  url       String
  caption   String?
  trailId   String
  reportId  String?
  createdAt DateTime @default(now())

  // Relations
  trail  Trail            @relation(fields: [trailId], references: [id], onDelete: Cascade)
  report ConditionReport? @relation(fields: [reportId], references: [id], onDelete: SetNull)

  // Indexes
  @@index([trailId, createdAt(sort: Desc)])
  @@index([reportId])
  @@map("photo")
}

// ConditionReport model - matches existing ConditionReport interface
model ConditionReport {
  id          String      @id @default(cuid())
  trailId     String
  userId      String
  status      Status
  confidence  Confidence
  vehicleType VehicleType
  notes       String?     @db.Text
  timestamp   DateTime    @default(now())
  createdAt   DateTime    @default(now())

  // Relations
  trail  Trail   @relation(fields: [trailId], references: [id], onDelete: Cascade)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos Photo[]

  // Indexes for common queries (reports by trail, sorted newest first)
  @@index([trailId, timestamp(sort: Desc)])
  @@index([userId])
  @@map("condition_reports")
}

model UserVehicle {
  id               String   @id @default(cuid())
  userId           String
  make             String
  model            String
  clearanceInches  Float
  tireSize         Float
  hasLowRange      Boolean  @default(false)
  hasWinch         Boolean  @default(false)
  experienceLevel  String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_vehicles")
}

model TripBundle {
  id              String   @id @default(cuid())
  userId          String
  scheduledDate   DateTime
  notes           String?  @db.Text
  isOfflineCached Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user   User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  trails TripBundleTrail[]

  @@index([userId, scheduledDate])
  @@map("trip_bundles")
}

model TripBundleTrail {
  id           String @id @default(cuid())
  tripBundleId String
  trailId      String
  sortOrder    Int

  tripBundle TripBundle @relation(fields: [tripBundleId], references: [id], onDelete: Cascade)
  trail      Trail      @relation(fields: [trailId], references: [id], onDelete: Cascade)

  @@unique([tripBundleId, trailId])
  @@index([tripBundleId, sortOrder])
  @@map("trip_bundle_trails")
}

// Waitlist model - 
model Waitlist {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
  status    String   @default("PENDING")

  @@map("waitlist") // This forces Prisma to look for the lowercase table
}
